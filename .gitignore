# 音乐文件与隐私数据绝不进仓库
music/
.cache/

# 歌单 = 个人数据（网页加歌会改服务器上的文件，进 git 会导致 pull 冲突）
playlists.json

# 音频格式全局兜底（防止音乐放在其他目录时被误提交）
*.mp3
*.ogg
*.flac
*.m4a
*.aac
*.wav
*.opus

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# 本地配置（如需自定义且不想入库）
config.local.json

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
